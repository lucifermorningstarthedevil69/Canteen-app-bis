
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isUserApproved(userId) {
        return get(/databases/$(database)/documents/users/$(userId)).data.status == 'approved';
    }

    function isCanteenStaff() {
        if (!isSignedIn()) {
          return false;
        }
        let userRole = getUserRole(request.auth.uid);
        // Admins can access regardless of approval status.
        // Canteen staff must be approved.
        if (isAdmin()) {
            return true;
        }
        if (userRole == 'canteen-incharge') {
            return true;
        }
        return false;
    }
    
    function isAdmin() {
        if (!isSignedIn()) {
          return false;
        }
        return getUserRole(request.auth.uid) == 'admin';
    }

    // Rules for menu items
    match /menuItems/{menuItemId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for orders
    match /orders/{orderId} {
      // Allow canteen staff to read/list all orders.
      // Customers can only read their own specific order.
      allow list: if isCanteenStaff();
      allow read: if isCanteenStaff() || (isOwner(resource.data.customerId) && isUserApproved(request.auth.uid));
      allow create: if isSignedIn() && isUserApproved(request.auth.uid);
      allow update: if isCanteenStaff();
      // Only owner or admin can delete their own order
      allow delete: if (isOwner(resource.data.customerId) && isUserApproved(request.auth.uid)) || isCanteenStaff();
    }
    
    // Rules for user profiles
    match /users/{userId} {
        // Admins can read all user profiles (for the management page).
        // Users can read their own profile.
        allow read: if isAdmin() || (isOwner(userId) && isSignedIn());
        
        // Any signed-in user can create their own user document during sign-up.
        allow create: if isOwner(userId);

        // Admins can update any user profile (to approve them or change roles).
        // Users can update their own profile information.
        allow update: if isAdmin() || (isOwner(userId) && isUserApproved(request.auth.uid));

        // Only admins can delete user profiles.
        allow delete: if isAdmin();
    }
  }
}
